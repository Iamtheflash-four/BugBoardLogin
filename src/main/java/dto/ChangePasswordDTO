package dto;

public class ChangePasswordDTO 
{
    public String token;
    public String oldPassword;
    public String newPassword;
    
    public ChangePasswordDTO() {}
    
    public String getToken() {
        return token;
    }
    
    public String getOldPassword() {
        return oldPassword;
    }
    
    public String getNewPassword() {
        return newPassword;
    }
}
